---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
}
const { href, variant = 'primary', external = false } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 font-semibold transition-colors',
    variant === 'primary'
      ? 'bg-cyan-400 text-slate-950 hover:bg-cyan-300'
      : 'border border-white/15 text-white hover:border-cyan-300 hover:text-cyan-300',
  ]}
>
  <slot />{external && <span aria-hidden="true">↗</span>}
</a>
