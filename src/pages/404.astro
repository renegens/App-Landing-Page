---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found | Giant Solutions">
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <Eyebrow>404</Eyebrow>
    <h1 class="text-4xl font-bold text-white">This page does not exist.</h1>
    <p class="mt-4 text-lg">It may have moved. The links below still work.</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/">Home</Button>
      <Button href="/services/" variant="secondary">Services</Button>
      <Button href="/book/" variant="secondary">Book</Button>
    </div>
  </section>
</Base>
