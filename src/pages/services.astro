---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { site } from '../config';
import { offers } from '../data/offers';

const steps = [
  { title: 'Intro call', text: 'Thirty minutes, free. You describe the team and the problem; I tell you honestly whether I can help.' },
  { title: 'Assessment', text: 'We find the step that holds your work up. Speeding up anything else changes nothing you can feel.' },
  { title: 'Setup', text: 'We change one workflow, add the checks that keep it safe, and measure the before and after.' },
  { title: 'Keep going', text: 'One workflow at a time, each with a number attached, until the team runs it without me.' },
];

const principles = [
  {
    title: 'Start with the bottleneck',
    text: 'An hour saved on a step that is not holding anything up is an hour nobody notices. We fix the step where work waits.',
  },
  {
    title: 'Checks, not promises',
    text: 'Agent output is treated like code from a new contributor: types, tests, linters and review decide what merges.',
  },
  {
    title: 'Nothing tied to one tool',
    text: 'Everything I set up works with any major coding agent. When a better model ships, you switch without starting over.',
  },
  {
    title: 'You own the result',
    text: 'Specs, skills, checks and the policy live in your repository, written so your team can maintain them.',
  },
];
---

<Base
  title="Services | Giant Solutions · George Gens"
  description="AI Opportunity Assessment, team setup sprints and ongoing support for software teams adopting AI coding agents."
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6 md:pt-20">
    <Eyebrow>Services</Eyebrow>
    <h1 class="max-w-3xl text-4xl leading-tight font-bold text-white md:text-5xl">
      AI that speeds up the whole team, not just the typing.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed">
      Every engagement is fixed in scope and price, quoted after a short intro call. It starts small
      and earns the next step.
    </p>
    <div class="mt-10">
      <Button href={site.contactUrl} external>Book an intro call</Button>
    </div>
  </section>

  <!-- Offers -->
  <section class="mx-auto max-w-6xl space-y-6 px-4 pb-20 sm:px-6">
    {
      offers.map((o, i) => (
        <article id={o.id} class="scroll-mt-8 rounded-lg border border-white/10 bg-white/5 p-6 md:p-8">
          <div class="grid gap-8 md:grid-cols-5">
            <div class="md:col-span-2">
              <span class="font-mono text-cyan-300">0{i + 1}</span>
              <h2 class="mt-2 text-2xl font-bold text-white">{o.name}</h2>
              <p class="mt-3 text-slate-400">{o.summary}</p>
              <p class="mt-4 font-mono text-sm text-slate-400">{o.length}</p>
            </div>
            <div class="md:col-span-3">
              <h3 class="mb-3 font-semibold text-white">What you get</h3>
              <ul class="space-y-2">
                {o.youGet.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-cyan-300" aria-hidden="true">→</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-6 rounded-md border border-cyan-300/20 bg-cyan-950/40 p-4 text-sm">
                <span class="font-semibold text-white">A good fit if: </span>
                {o.fitIf}
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- Process -->
  <section class="border-y border-white/10 bg-slate-900/60">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <Eyebrow>How it works</Eyebrow>
      <ol class="mt-6 grid gap-6 md:grid-cols-4">
        {
          steps.map((s, i) => (
            <li>
              <span class="font-mono text-sm text-cyan-300">Step {i + 1}</span>
              <h3 class="mt-1 mb-2 font-semibold text-white">{s.title}</h3>
              <p class="text-slate-400">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Principles -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <Eyebrow>How I work</Eyebrow>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        principles.map((p) => (
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <h3 class="mb-2 font-semibold text-white">{p.title}</h3>
            <p class="text-slate-400">{p.text}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-10 max-w-2xl text-slate-400">
      These ideas come from the book I am writing,
      <a href="/book/" class="text-cyan-300 underline underline-offset-4 hover:text-white">AI for Developers</a>.
      Giant Solutions also takes on custom software and robotics projects.
    </p>
    <div class="mt-8">
      <Button href={site.contactUrl} external>Start a conversation</Button>
    </div>
  </section>
</Base>
